zig-out/
zig-pkg/

# The symlink `nix build` leaves behind.
/result

# Where `zig build fuzz-run` puts an input that failed. Worth reading and, if
# it is a shape rather than an accident, worth adding to the corpus in
# tests/fuzz.zig -- but not worth keeping as it lands.
/fuzz-findings/

# Left behind when a tool here is imported rather than run.
__pycache__/
